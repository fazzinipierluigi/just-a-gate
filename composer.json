{
    "name": "fazzinipierluigi/just-a-gate",
    "description": "A package that introduces a simple but very flexible and powerful ACL",
    "license": "MIT",
    "authors": [
        {
            "name": "Pierluigi Fazzini",
            "email": "fazzinipierluigi@gmail.com"
        }
    ],
    "homepage": "https://github.com/fazzinipierluigi/just-a-gate",
    "keywords": ["Laravel", "JustAGate", "ACL", "Permissions", "Roles"],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/prompts": "^0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Fazzinipierluigi\\JustAGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fazzinipierluigi\\JustAGate\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fazzinipierluigi\\JustAGate\\JustAGateServiceProvider"
            ],
            "aliases": {
                "JustAGate": "Fazzinipierluigi\\JustAGate\\Facades\\JustAGate"
            }
        }
    }
}
